---
/**
 * The home page, rendered from `site.sections`.
 *
 * Five block types cover most of what a local business needs. When a client
 * genuinely needs a sixth, it is added HERE and becomes available to every
 * site — a block that exists only in one client's repo is a block the next
 * client pays to have built again.
 */
import type { Section } from '../lib/site';

type Props = { sections: Section[] };
const { sections } = Astro.props;
---

{
  sections.map((s) => {
    if (s.type === 'hero') {
      return (
        <section class="hero">
          <div class="wrap">
            <h1>{s.heading}</h1>
            {s.text && <p class="lede">{s.text}</p>}
            {s.cta && <p><a class="button" href={s.cta.href}>{s.cta.label}</a></p>}
            {s.image && <img src={s.image} alt="" class="hero-img" />}
          </div>
        </section>
      );
    }

    if (s.type === 'text') {
      return (
        <section id={s.id}>
          <div class="wrap">
            {s.heading && <h2>{s.heading}</h2>}
            {s.body.map((para) => <p>{para}</p>)}
          </div>
        </section>
      );
    }

    if (s.type === 'cards') {
      return (
        <section id={s.id}>
          <div class="wrap">
            {s.heading && <h2>{s.heading}</h2>}
            <div class="cards">
              {s.items.map((item) => (
                <div class="card">
                  <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
                  {item.text && <p>{item.text}</p>}
                </div>
              ))}
            </div>
          </div>
        </section>
      );
    }

    if (s.type === 'gallery') {
      return (
        <section id={s.id}>
          <div class="wrap">
            {s.heading && <h2>{s.heading}</h2>}
            <div class="gallery">
              {s.images.map((img) => (
                /* `loading="lazy"` and real dimensions are the difference
                   between a gallery and a reason the site feels slow. */
                <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
              ))}
            </div>
          </div>
        </section>
      );
    }

    if (s.type === 'cta') {
      return (
        <section class="cta">
          <div class="wrap">
            <h2>{s.heading}</h2>
            {s.text && <p class="lede">{s.text}</p>}
            {s.cta && <p><a class="button" href={s.cta.href}>{s.cta.label}</a></p>}
          </div>
        </section>
      );
    }

    return null;
  })
}

<style>
  .hero { padding-block: clamp(3rem, 10vw, 6rem); }
  .hero p { max-width: 46ch; }
  .hero-img { margin-top: 2rem; border-radius: var(--radius); }

  .cards {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .card {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem;
  }
  .card h3 { margin-bottom: 0.35rem; }
  .card h3 a { text-decoration: none; }
  .card p { margin: 0; color: var(--ink-dim); }

  .gallery {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .gallery img {
    border-radius: var(--radius);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }

  .cta { background: var(--bg-2); }
</style>
