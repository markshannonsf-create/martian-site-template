---
import { site } from '../lib/site';
---

<header>
  <div class="wrap bar">
    <a class="brand" href="/">
      {site.name}
    </a>

    {
      site.nav.length > 0 && (
        <nav aria-label="Main">
          {site.nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      )
    }
  </div>
</header>

<style>
  /*
   * No hamburger, and no JavaScript to open one. Four or five links wrap onto
   * a second line on a phone perfectly well, and a menu that has to be opened
   * is a menu half the visitors never open. If a client genuinely needs a
   * dozen links, that is a sign the site needs a different shape rather than
   * a drawer.
   */
  header {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 5;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 1.25rem;
    padding-block: 0.9rem;
  }

  .brand {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
  }

  nav a {
    color: var(--ink-dim);
    text-decoration: none;
    font-size: 0.95rem;
  }
  nav a:hover { color: var(--ink); }
</style>
